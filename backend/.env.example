# Environment Configuration

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=hackathon-secret-key-bob-2.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database (Default: SQLite local file)
DATABASE_URL=sqlite:///./kanban_evidence.db

# IBM watsonx.ai
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2
# Enable mock fallback mode when watsonx API key is empty or API fails
WATSONX_USE_FALLBACK_ON_ERROR=true

# GitHub Webhook & App
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_ACCESS_TOKEN=your_optional_github_pat_here
